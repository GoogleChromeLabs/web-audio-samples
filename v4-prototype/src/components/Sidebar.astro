import { getCollection } from 'astro:content';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

let allGuides: any[] = [];
try {
  allGuides = await getCollection('guides');
} catch {
  allGuides = [];
}

let allTests: any[] = [];
try {
  allTests = await getCollection('tests');
} catch {
  allTests = [];
}

const basicCount = allGuides.filter((g) => g.data.category === 'basic').length;
const patternCount = allGuides.filter(
  (g) => g.data.category === 'design-pattern'
).length;
const migrationCount = allGuides.filter(
  (g) => g.data.category === 'migration'
).length;
const manualCount = allTests.filter((t) => t.data.category === 'manual').length;
const benchmarkCount = allTests.filter(
  (t) => t.data.category === 'benchmark'
).length;

const navSections = [
  {
    id: 'audio-worklet',
    title: 'Audio Worklet Guides',
    items: [
      {
        label: 'Basic',
        href: `${base}/audio-worklet/basic/`,
        matchPrefix: `${base}/audio-worklet/basic`,
        count: basicCount,
      },
      {
        label: 'Design Pattern',
        href: `${base}/audio-worklet/design-pattern/`,
        matchPrefix: `${base}/audio-worklet/design-pattern`,
        count: patternCount,
      },
      {
        label: 'Migration Pattern',
        href: `${base}/audio-worklet/migration/`,
        matchPrefix: `${base}/audio-worklet/migration`,
        count: migrationCount,
      },
    ],
  },
  {
    id: 'test-suite',
    title: 'Test Suite',
    items: [
      {
        label: 'Manual Tests',
        href: `${base}/tests/manual/`,
        matchPrefix: `${base}/tests/manual`,
        count: manualCount,
      },
      {
        label: 'Benchmarks',
        href: `${base}/tests/benchmark/`,
        matchPrefix: `${base}/tests/benchmark`,
        count: benchmarkCount,
      },
    ],
  },
];

const directLinks = [
  {
    label: 'Apps and Demos',
    href: `${base}/demos/`,
    matchPrefix: `${base}/demos`,
    count: 9,
  },
  {
    label: 'Resources',
    href: `${base}/resources/`,
    matchPrefix: `${base}/resources`,
    count: 8,
  },
];

function isItemActive(href: string, matchPrefix: string): boolean {
  const normCurrent = currentPath.replace(/\/$/, '');
  const normHref = href.replace(/\/$/, '');
  const normPrefix = matchPrefix.replace(/\/$/, '');
  return (
    normCurrent === normHref || normCurrent.startsWith(normPrefix + '/')
  );
}
---

<!-- Sliding Drawer Backdrop -->
<div
  id="sidebar-backdrop"
  class:list={[
    'fixed inset-0 top-16 bg-slate-900/25 z-30',
    'transition-opacity duration-300 opacity-0 pointer-events-none',
  ]}
  aria-hidden="true"
>
</div>

<!-- Animated Left Drawer -->
<aside
  id="sidebar-drawer"
  class:list={[
    'fixed top-16 left-0 z-40 h-[calc(100vh-4rem)]',
    'w-72 sm:w-80 shrink-0 bg-white border-r border-slate-200',
    'p-6 space-y-4 overflow-y-auto shadow-2xl',
    'transform -translate-x-full',
    'transition-transform duration-300 ease-in-out',
  ]}
  aria-label="Sidebar navigation"
>
  <!-- Collapsible Navigation Sections -->
  <div class="space-y-3">
    {
      navSections.map((section) => {
        return (
          <details
            class="sidebar-section group pb-2"
            open={true}
            data-section-id={section.id}
          >
            <summary
              class="flex items-center justify-between cursor-pointer
                list-none py-1.5 px-2.5 -mx-2.5 rounded-md text-xs font-bold
                uppercase tracking-wider text-slate-600 hover:text-blue-600
                hover:bg-slate-50 transition-colors select-none
                [&::-webkit-details-marker]:hidden"
            >
              <span>{section.title}</span>
              <svg
                class="w-4 h-4 text-slate-400 group-hover:text-blue-600
                  transition-transform duration-200 group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </summary>
            <ul class="mt-1 space-y-1 text-sm pl-3">
              {section.items.map((item) => {
                const active = isItemActive(item.href, item.matchPrefix);
                return (
                  <li>
                    <a
                      href={item.href}
                      class:list={[
                        'flex items-center justify-between px-2.5 py-1.5 ' +
                          'rounded-md transition-colors',
                        active
                          ? 'bg-blue-50 text-blue-700 font-semibold'
                          : 'text-slate-600 hover:text-slate-900 ' +
                            'hover:bg-slate-50',
                      ]}
                    >
                      <span>{item.label}</span>
                      {item.count !== undefined && (
                        <span
                          class:list={[
                            'inline-flex items-center justify-center w-5 ' +
                              'h-5 text-xs rounded font-medium shrink-0',
                            active
                              ? 'bg-blue-100 text-blue-700'
                              : 'bg-slate-100 text-slate-500',
                          ]}
                        >
                          {item.count}
                        </span>
                      )}
                    </a>
                  </li>
                );
              })}
            </ul>
          </details>
        );
      })
    }

    <!-- Top-Level Direct Links (Apps and Demos, Resources) -->
    <div class="space-y-1">
      {
        directLinks.map((item) => {
          const active = isItemActive(item.href, item.matchPrefix);
          return (
            <a
              href={item.href}
              class:list={[
                'flex items-center justify-between px-2.5 -mx-2.5 py-1.5 ' +
                  'rounded-md text-xs font-bold uppercase tracking-wider ' +
                  'transition-colors select-none',
                active
                  ? 'bg-blue-50 text-blue-700 font-bold'
                  : 'text-slate-600 hover:text-blue-600 hover:bg-slate-50',
              ]}
            >
              <span>{item.label}</span>
              {item.count !== undefined && (
                <span
                  class:list={[
                    'inline-flex items-center justify-center w-5 h-5 ' +
                      'text-xs rounded font-medium shrink-0 normal-case ' +
                      'tracking-normal',
                    active
                      ? 'bg-blue-100 text-blue-700'
                      : 'bg-slate-100 text-slate-500',
                  ]}
                >
                  {item.count}
                </span>
              )}
            </a>
          );
        })
      }
    </div>
  </div>
</aside>

<script>
  const toggleBtn = document.getElementById('sidebar-toggle');
  const drawer = document.getElementById('sidebar-drawer');
  const backdrop = document.getElementById('sidebar-backdrop');

  let isOpen = false;

  function openDrawer() {
    if (!drawer || !backdrop) return;
    drawer.classList.remove('-translate-x-full');
    drawer.classList.add('translate-x-0');
    backdrop.classList.remove('opacity-0', 'pointer-events-none');
    backdrop.classList.add('opacity-100', 'pointer-events-auto');
    isOpen = true;
  }

  function closeDrawer() {
    if (!drawer || !backdrop) return;
    drawer.classList.remove('translate-x-0');
    drawer.classList.add('-translate-x-full');
    backdrop.classList.remove('opacity-100', 'pointer-events-auto');
    backdrop.classList.add('opacity-0', 'pointer-events-none');
    isOpen = false;
  }

  function toggleDrawer() {
    if (isOpen) {
      closeDrawer();
    } else {
      openDrawer();
    }
  }

  toggleBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleDrawer();
  });

  backdrop?.addEventListener('click', closeDrawer);

  drawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeDrawer);
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      closeDrawer();
    }
  });

  // Collapsible section management and state persistence
  const sectionElements =
    drawer?.querySelectorAll<HTMLDetailsElement>('details.sidebar-section');

  sectionElements?.forEach((details) => {
    const id = details.dataset.sectionId;
    if (id) {
      const saved = localStorage.getItem(`sidebar_section_${id}`);
      const hasActive = details.querySelector('a.bg-blue-50') !== null;
      if (hasActive) {
        details.open = true;
      } else if (saved !== null) {
        details.open = saved === 'true';
      }
    }

    details.addEventListener('toggle', () => {
      if (id) {
        localStorage.setItem(`sidebar_section_${id}`, String(details.open));
      }
    });
  });
</script>
