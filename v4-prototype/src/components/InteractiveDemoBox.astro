import AudioControlPanel from './AudioControlPanel.astro';

interface Props {
  title?: string;
  description?: string;
  scriptSrc?: string;
}

const {
  title = 'Audio Playback Check',
  description = 'Click START to run this audio sample.',
  scriptSrc,
} = Astro.props;
---

<div
  id="demo-box"
  data-script-src={scriptSrc}
  class="my-6 rounded-xl border-2 border-blue-400/80 bg-blue-50/20 shadow-sm
    overflow-hidden transition-all duration-200"
>
  <div class="p-5 flex flex-col justify-between gap-6 min-h-[110px]">
    <div class="space-y-1">
      <h3 class="text-base font-semibold text-slate-900">
        {title}
      </h3>
      {
        description && (
          <p class="text-[1.05rem] text-slate-600 leading-relaxed">
            {description}
          </p>
        )
      }
    </div>

    <!-- Optional custom demo controls slot -->
    <slot />

    <!-- Audio transport & diagnostics panel -->
    <AudioControlPanel scriptSrc={scriptSrc} />
  </div>
</div>
