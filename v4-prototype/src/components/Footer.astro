<footer class="border-t border-slate-200 bg-slate-50/50 mt-auto">
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 py-8 flex flex-col sm:flex-row
      items-center justify-between gap-4 text-xs text-slate-500"
  >
    <div class="flex items-center gap-2">
      <img
        src="/chrome-logo.png"
        alt="Google Chrome"
        class="w-4 h-4 object-contain opacity-70"
        width="16"
        height="16"
      />
      <span>
        Web Audio Samples &bull; Released under BSD-3-Clause License
      </span>
    </div>

    <nav class="flex items-center gap-6 font-medium text-slate-600">
      <a
        href="https://github.com/GoogleChromeLabs/web-audio-samples"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-blue-600 transition-colors"
      >
        GitHub
      </a>
      <a
        href="https://www.w3.org/TR/webaudio/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-blue-600 transition-colors"
      >
        W3C Specification
      </a>
      <a
        href="https://developer.chrome.com/blog/audio-worklet/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-blue-600 transition-colors"
      >
        AudioWorklet Guide
      </a>
    </nav>
  </div>
</footer>
