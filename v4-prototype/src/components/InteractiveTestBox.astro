interface Props {
  title?: string;
  description?: string;
  scriptSrc?: string;
}

const {
  title = 'Test Fixture Execution',
  description = 'Press Start Test to execute this test fixture.',
  scriptSrc,
} = Astro.props;
---

<div
  id="test-harness-box"
  data-script-src={scriptSrc}
  class="my-6 rounded-xl border-2 border-slate-300 bg-white shadow-sm
    overflow-hidden transition-all duration-200"
>
  <!-- Harness Header & Controls Bar -->
  <div class="p-6 border-b border-slate-100 space-y-4">
    <div
      class="flex flex-col sm:flex-row sm:items-center justify-between
        gap-4"
    >
      <div class="space-y-1">
        <h2 class="text-base font-bold text-slate-900">
          {title}
        </h2>
        {
          description && (
            <p class="text-xs text-slate-500">
              {description}
            </p>
          )
        }
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2.5 shrink-0">
        <button
          id="button-start-test"
          type="button"
          class="px-5 py-2 rounded-lg bg-blue-600 hover:bg-blue-700
            text-white font-medium text-xs tracking-wide transition-colors
            cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
        >
          START TEST
        </button>
        <button
          id="button-stop-test"
          type="button"
          disabled
          class="px-4 py-2 rounded-lg bg-slate-100 hover:bg-slate-200
            text-slate-700 font-medium text-xs tracking-wide transition-colors
            cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
        >
          STOP
        </button>
      </div>
    </div>

    <!-- Custom Controls Slot (e.g. dropdowns, switches, axis cards) -->
    <slot name="controls" />
  </div>

  <!-- Realtime Inspector Panel -->
  <div class="px-6 py-4 bg-slate-50 border-b border-slate-100">
    <div class="flex items-center justify-between mb-2">
      <span
        class="text-xs font-semibold text-slate-700 uppercase tracking-wider"
      >
        AudioContext &amp; Node Inspector
      </span>
      <span
        id="test-status-badge"
        class="text-[11px] font-semibold px-2 py-0.5 rounded-md bg-slate-200
          text-slate-600"
      >
        IDLE
      </span>
    </div>
    <div
      id="test-inspector"
      class="p-3.5 rounded-lg bg-white border border-slate-200 font-mono
        text-xs text-slate-700 whitespace-pre leading-relaxed"
    >
      Ready. Press START TEST to initialize AudioContext.
    </div>
  </div>

  <!-- Execution Console Log Output -->
  <div class="bg-slate-900 p-6">
    <div
      class="flex items-center justify-between pb-3 mb-3 border-b
        border-slate-800"
    >
      <span
        class="text-xs font-semibold text-slate-300 tracking-wide uppercase"
      >
        Execution Log
      </span>
      <button
        id="button-clear-log"
        type="button"
        class="text-xs text-slate-400 hover:text-slate-200 transition-colors
          cursor-pointer"
      >
        Clear Log
      </button>
    </div>
    <div
      id="test-log"
      class="font-mono text-xs text-slate-300 whitespace-pre-wrap h-44
        overflow-y-auto leading-relaxed"
    ></div>
  </div>
</div>

{
  scriptSrc && (
    <script type="module" src={scriptSrc}></script>
  )
}
