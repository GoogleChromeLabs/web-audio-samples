---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = base ? `${base}/` : '/';
const logoUrl = base ? `${base}/chrome-logo.png` : '/chrome-logo.png';
---

<header
  class="border-b border-slate-200 bg-white sticky top-0 z-50 h-16"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 h-full flex items-center
      justify-between"
  >
    <!-- Left: Hamburger button + Text Title -->
    <div class="flex items-center gap-3">
      <button
        id="sidebar-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        class="p-2 -ml-2 rounded-md text-slate-700 hover:text-slate-900
          hover:bg-slate-100 focus:outline-none cursor-pointer"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          ></path>
        </svg>
      </button>

      <a
        href={homeUrl}
        class="font-semibold text-lg text-slate-900 hover:text-blue-600
          transition-colors"
      >
        Web Audio Samples
      </a>
    </div>

    <!-- Right: Navigation Links + Chrome Logo -->
    <nav class="flex items-center gap-5 text-sm font-medium text-slate-600">
      <a
        href={base ? `${base}/audio-worklet/` : '/audio-worklet/'}
        class="hover:text-slate-900 transition-colors hidden sm:block"
      >
        Guides
      </a>
      <a
        href={base ? `${base}/demos/` : '/demos/'}
        class="hover:text-slate-900 transition-colors hidden sm:block"
      >
        Demos
      </a>
      <a
        href={base ? `${base}/showcases/` : '/showcases/'}
        class="hover:text-slate-900 transition-colors hidden sm:block"
      >
        Showcases
      </a>
      <a
        href={base ? `${base}/tests/` : '/tests/'}
        class="hover:text-slate-900 transition-colors hidden sm:block"
      >
        Tests
      </a>
      <a
        href="https://github.com/GoogleChromeLabs/web-audio-samples"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-slate-900 transition-colors flex items-center gap-1"
      >
        <span>GitHub</span>
        <svg
          class="w-3.5 h-3.5 opacity-60"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M14 4h6m0 0v6m0-6L10 14"
          ></path>
        </svg>
      </a>

      <a
        href="https://www.w3.org/TR/webaudio/"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:flex items-center gap-1 hover:text-slate-900"
      >
        <span>Specification</span>
        <svg
          class="w-3.5 h-3.5 opacity-60"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M14 4h6m0 0v6m0-6L10 14"
          ></path>
        </svg>
      </a>

      <!-- Google Chrome Logo Image -->
      <a
        href="https://www.google.com/chrome/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center hover:opacity-80 transition-opacity ml-1"
        title="Google Chrome"
        aria-label="Google Chrome"
      >
        <img
          src={logoUrl}
          alt="Google Chrome"
          class="w-5 h-5 object-contain"
          width="20"
          height="20"
        />
      </a>
    </nav>
  </div>
</header>
