import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allTests = await getCollection('tests');

const manualTests = allTests
  .filter((t) => t.data.category === 'manual')
  .sort((a, b) => a.data.order - b.data.order);

const regressionTests = allTests
  .filter((t) => t.data.category === 'regression')
  .sort((a, b) => a.data.order - b.data.order);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = base ? `${base}/tests/` : '/tests/';

const pageDescription =
  'Interactive manual test harnesses, device routing fixtures, and ' +
  'regression verification tests for the Web Audio API.';
---

<Layout
  title="Tests and Benchmarks | Web Audio Samples"
  currentPath={currentPath}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header Section -->
    <div class="max-w-3xl mb-12">
      <h1
        class="text-3xl sm:text-4xl font-extrabold text-slate-900
          tracking-tight"
      >
        Tests &amp; Benchmarks
      </h1>
      <p
        class="mt-4 text-slate-600 leading-relaxed"
        style="font-size: 1.1rem;"
      >
        {pageDescription}
      </p>
    </div>

    <!-- Section 1: Manual & Integration Tests -->
    <div class="mb-14">
      <div class="border-b border-slate-200 pb-4 mb-6">
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">
          Manual &amp; Device Routing Tests
        </h2>
        <p class="mt-1 text-slate-500 text-sm">
          Interactive test harnesses for browser capabilities, hardware routing,
          and spatial audio rendering.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          manualTests.map((test) => (
            <div
              class="group relative flex flex-col bg-white rounded-xl
                border border-slate-200 hover:border-blue-400 hover:shadow-md
                transition-all duration-200 p-6"
            >
              <div class="flex items-center justify-between gap-3 mb-2">
                <h3
                  class="text-xl font-bold text-slate-900
                    group-hover:text-blue-600 transition-colors"
                >
                  <a
                    href={`${base}/tests/${test.data.category}/${test.id}/`}
                    class="focus:outline-none"
                  >
                    <span class="absolute inset-0" aria-hidden="true" />
                    {test.data.title}
                  </a>
                </h3>
                <span
                  class="inline-flex items-center px-2.5 py-0.5 rounded-full
                    text-xs font-medium bg-blue-50 text-blue-700
                    border border-blue-200 shrink-0 capitalize"
                >
                  {test.data.category}
                </span>
              </div>
              <p
                class="text-slate-600 leading-relaxed grow mt-1"
                style="font-size: 1.1rem;"
              >
                {test.data.description}
              </p>
              <div
                class="mt-4 flex items-center text-sm font-semibold
                  text-blue-600 group-hover:text-blue-700"
              >
                Run test fixture
                <svg
                  class="w-4 h-4 ml-1 transform group-hover:translate-x-1
                    transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Section 2: Resampling & Regression Tests -->
    <div class="mb-14">
      <div class="border-b border-slate-200 pb-4 mb-6">
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">
          Resampling &amp; Bug Verifications
        </h2>
        <p class="mt-1 text-slate-500 text-sm">
          Edge case repros, buffer resampling verification, and audio graph
          stability tests.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          regressionTests.map((test) => (
            <div
              class="group relative flex flex-col bg-white rounded-xl
                border border-slate-200 hover:border-blue-400 hover:shadow-md
                transition-all duration-200 p-6"
            >
              <div class="flex items-center justify-between gap-3 mb-2">
                <h3
                  class="text-xl font-bold text-slate-900
                    group-hover:text-blue-600 transition-colors"
                >
                  <a
                    href={`${base}/tests/${test.data.category}/${test.id}/`}
                    class="focus:outline-none"
                  >
                    <span class="absolute inset-0" aria-hidden="true" />
                    {test.data.title}
                  </a>
                </h3>
                <span
                  class="inline-flex items-center px-2.5 py-0.5 rounded-full
                    text-xs font-medium bg-amber-50 text-amber-700
                    border border-amber-200 shrink-0 capitalize"
                >
                  {test.data.category}
                </span>
              </div>
              <p
                class="text-slate-600 leading-relaxed grow mt-1"
                style="font-size: 1.1rem;"
              >
                {test.data.description}
              </p>
              <div
                class="mt-4 flex items-center text-sm font-semibold
                  text-blue-600 group-hover:text-blue-700"
              >
                Run test fixture
                <svg
                  class="w-4 h-4 ml-1 transform group-hover:translate-x-1
                    transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
