import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const allTests = await getCollection('tests');

const manualTests = allTests
  .filter((t) => t.data.category === 'manual')
  .sort((a, b) => a.data.order - b.data.order);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = base ? `${base}/tests/manual/` : '/tests/manual/';

const pageDescription =
  'Interactive manual test harnesses, device routing, and ' +
  'verification tests.';

const breadcrumbs = [{ label: 'Test Suite' }];
---

<Layout
  title="Manual Tests - Web Audio Samples"
  description={pageDescription}
  currentPath={currentPath}
>
  <article class="max-w-4xl space-y-8">
    <header class="space-y-3 pb-2">
      <Breadcrumb items={breadcrumbs} />
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">
        Manual Tests
      </h1>
      <p class="text-slate-600 text-[1.05rem] leading-relaxed">
        Interactive verification fixtures and manual harnesses for browser
        capabilities, device routing, spatial audio rendering, and resampler
        stability.
      </p>
    </header>

    <section class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          manualTests.map((test) => (
            <a
              href={`${base}/tests/manual/${test.id}/`}
              class="p-5 rounded-lg border border-slate-200
                hover:border-blue-300 hover:bg-blue-50/30 transition-all
                block space-y-2 group"
            >
              <h2
                class="font-semibold text-slate-900 text-xl
                  group-hover:text-blue-600 transition-colors"
              >
                {test.data.title}
              </h2>
              {test.data.description && (
                <p class="text-[1.05rem] text-slate-600 leading-relaxed">
                  {test.data.description}
                </p>
              )}
            </a>
          ))
        }
      </div>
    </section>
  </article>
</Layout>
