import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = base ? `${base}/demos/` : '/demos/';

const breadcrumbs = [{ label: 'Apps and Demos' }];

const curatedDemos = [
  {
    title: 'Shiny Drum Machine',
    href: `${base}/demos/shiny-drum-machine/`,
    tag: 'Sequencer',
    badgeClass: 'bg-blue-50 text-blue-700',
    image: `${base}/images/demos/shiny-drum-machine.png`,
    description:
      'Classic 16-step drum sequencer with multiple kits, swing timing, ' +
      'stereo delay, and convolution reverb.',
  },
  {
    title: 'Mother Language Day Drum Sampler',
    href: `${base}/demos/mld-drum-sampler/`,
    tag: 'Sampler',
    badgeClass: 'bg-amber-50 text-amber-700',
    image: `${base}/images/demos/mld-drum-sampler.png`,
    description:
      'Interactive drum sampler featuring Korean traditional percussion ' +
      'samples, dynamic convolution acoustics, and directory loading.',
  },
  {
    title: 'Web Audio DJ',
    href: `${base}/demos/dj/`,
    tag: 'Mixing',
    badgeClass: 'bg-indigo-50 text-indigo-700',
    image: `${base}/images/demos/dj.png`,
    description:
      'Dual-deck crossfader DJ mixing console with real-time frequency ' +
      'filtering, beat-synced loops, and live spectrogram analysis.',
  },
  {
    title: 'WebGL 3D Pool with Spatial Audio',
    href: `${base}/demos/pool/`,
    tag: '3D Spatial',
    badgeClass: 'bg-emerald-50 text-emerald-700',
    image: `${base}/images/demos/pool.png`,
    description:
      'Full 3D physics-based pool game built with WebGL and spatialized ' +
      '3D audio listener rendering for cue hits, collisions, and pockets.',
  },
  {
    title: 'AnalyserNode Frequency Visualizer',
    href: `${base}/demos/visualizer/`,
    tag: 'Analysis',
    badgeClass: 'bg-cyan-50 text-cyan-700',
    image: `${base}/images/demos/visualizer.png`,
    description:
      'Real-time 3D frequency spectrum, sonogram, and waveform ' +
      'visualization powered by WebGL and AnalyserNode FFT.',
  },
  {
    title: 'Wavetable Synthesizer',
    href: `${base}/demos/wavetable-synth/`,
    tag: 'Synthesis',
    badgeClass: 'bg-purple-50 text-purple-700',
    image: `${base}/images/demos/wavetable-synth.png`,
    description:
      'Interactive wavetable synthesizer featuring over 50 wave-table ' +
      'profiles, step sequencing, waveshaper saturation, and BPM delay.',
  },
  {
    title: 'Panning & Reverberation',
    href: `${base}/demos/panning-reverberation/`,
    tag: 'Spatial',
    badgeClass: 'bg-teal-50 text-teal-700',
    image: `${base}/images/demos/panning-reverberation.png`,
    description:
      'Interactive 3D binaural and equal-power sound spatialization with ' +
      'PannerNode positioning and ConvolverNode room acoustics.',
  },
  {
    title: 'Box2D Physics Audio Stress Test',
    href: `${base}/demos/stress-box/`,
    tag: 'Performance',
    badgeClass: 'bg-rose-50 text-rose-700',
    image: `${base}/images/demos/stress-box.png`,
    description:
      'High-density rigid-body physics simulation generating concurrent ' +
      'polyphonic collision impacts to benchmark audio engine limits.',
  },
  {
    title: 'Offline PWA Audio Recorder',
    href: `${base}/demos/pwa-audio-recorder/`,
    tag: 'Utility',
    badgeClass: 'bg-slate-100 text-slate-700',
    image: `${base}/images/demos/pwa-audio-recorder.png`,
    description:
      'Progressive Web App for microphone capture, IndexedDB audio clip ' +
      'management, and responsive waveform visualization.',
  },
];

---

<Layout
  title="Apps and Demos - Web Audio Samples"
  description="Interactive Web Audio demos, synths, and audio experiments."
  currentPath={currentPath}
>
  <article class="max-w-4xl space-y-12">
    <header class="space-y-3 pb-2">
      <Breadcrumb items={breadcrumbs} />
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">
        Apps and Demos
      </h1>
      <p class="text-slate-600 text-[1.05rem] leading-relaxed">
        Explore interactive drum sequencers, spatial audio simulations,
        wavetable synthesizers, and Web Audio applications.
      </p>
    </header>

    <!-- Demos List -->
    <section class="space-y-4">
      <div class="flex flex-col space-y-4">
        {
          curatedDemos.map((demo) => (
            <a
              href={demo.href}
              class="group flex flex-col sm:flex-row items-start sm:items-center
                gap-5 p-4 sm:p-5 rounded-xl border border-slate-200
                hover:border-blue-300 hover:bg-blue-50/30 transition-all"
            >
              <div
                class="w-full sm:w-52 md:w-56 shrink-0 aspect-[16/10] rounded-lg
                  overflow-hidden bg-slate-100 border border-slate-200/80"
              >
                <img
                  src={demo.image}
                  alt={`Screenshot of ${demo.title}`}
                  class="w-full h-full object-cover object-top
                    group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
              <div class="flex-1 min-w-0 space-y-2">
                <div class="flex items-center gap-2.5 flex-wrap">
                  <h2
                    class="text-xl font-semibold text-slate-900
                      group-hover:text-blue-600 transition-colors"
                  >
                    {demo.title}
                  </h2>
                  <span
                    class:list={[
                      'text-xs font-medium px-2 py-0.5 rounded',
                      demo.badgeClass,
                    ]}
                  >
                    {demo.tag}
                  </span>
                </div>
                <p class="text-[1.05rem] text-slate-600 leading-relaxed">
                  {demo.description}
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </article>
</Layout>
