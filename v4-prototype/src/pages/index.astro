import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const guidesUrl = base ? `${base}/audio-worklet/` : '/audio-worklet/';
const demosUrl = base ? `${base}/demos/` : '/demos/';
const showcasesUrl = base ? `${base}/showcases/` : '/showcases/';
const testsUrl = base ? `${base}/tests/` : '/tests/';
---

<Layout
  title="Web Audio Samples - Developer Portal"
  description="High-performance Web Audio API guides and interactive demos."
  currentPath={base ? `${base}/` : '/'}
>
  <article class="max-w-4xl space-y-10 py-4">
    <header class="space-y-3 border-b border-slate-200 pb-8">
      <div class="inline-flex items-center gap-2">
        <span
          class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-blue-50
            text-blue-700 border border-blue-200 uppercase tracking-wider"
        >
          Developer Portal
        </span>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900">
        Web Audio Samples
      </h1>
      <p class="text-slate-600 text-[1.1rem] leading-relaxed">
        High-performance Web Audio API guides, AudioWorklet design patterns,
        and interactive demos curated by the Chrome Web Audio team.
      </p>
    </header>

    <!-- Top Pillars: Guides vs Demos -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <a
        href={guidesUrl}
        class="p-6 rounded-xl border border-slate-200 hover:border-blue-300
          hover:bg-blue-50/20 transition-all block space-y-3 group"
      >
        <div class="flex items-center justify-between">
          <div
            class="w-10 h-10 rounded-lg bg-blue-100 text-blue-700 flex
              items-center justify-center font-bold text-sm"
          >
            AW
          </div>
          <span
            class="text-xs font-semibold text-blue-600
              group-hover:translate-x-0.5 transition-transform"
          >
            14 Guides &rarr;
          </span>
        </div>
        <h2 class="text-xl font-bold text-slate-900">
          AudioWorklet Guides
        </h2>
        <p class="text-[1.1rem] text-slate-600 leading-relaxed">
          Comprehensive AudioWorklet implementation guides, bypass routing,
          lock-free SharedArrayBuffer queues, and C++/WASM audio kernels.
        </p>
      </a>

      <a
        href={demosUrl}
        class="p-6 rounded-xl border border-slate-200 hover:border-blue-300
          hover:bg-blue-50/20 transition-all block space-y-3 group"
      >
        <div class="flex items-center justify-between">
          <div
            class="w-10 h-10 rounded-lg bg-purple-100 text-purple-700 flex
              items-center justify-center font-bold text-sm"
          >
            DM
          </div>
          <span
            class="text-xs font-semibold text-purple-600
              group-hover:translate-x-0.5 transition-transform"
          >
            Interactive Apps &rarr;
          </span>
        </div>
        <h2 class="text-xl font-bold text-slate-900">
          Apps &amp; Demos
        </h2>
        <p class="text-[1.1rem] text-slate-600 leading-relaxed">
          Playable vintage drum sequencers, dual-deck DJ consoles, 3D WebGL
          spatial pool, wavetable synthesizers, and audio visualizers.
        </p>
      </a>
    </section>

    <!-- AudioWorklet Categories Breakdown -->
    <section class="space-y-4 pt-2">
      <h2 class="text-xl font-bold text-slate-900">
        AudioWorklet Knowledge Pillars
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a
          href={guidesUrl}
          class="p-5 rounded-lg border border-slate-200 hover:border-blue-300
            hover:bg-blue-50/20 transition-all block space-y-2"
        >
          <div
            class="w-8 h-8 rounded bg-blue-100 text-blue-700 flex
              items-center justify-center font-bold text-xs"
          >
            01
          </div>
          <h3 class="text-base font-bold text-slate-900">
            Worklet Basics
          </h3>
          <p class="text-[1.1rem] text-slate-600 leading-relaxed">
            Tone routing, noise generation, bitcrushing, error handling, and
            AudioParam automation.
          </p>
        </a>

        <a
          href={guidesUrl}
          class="p-5 rounded-lg border border-slate-200 hover:border-blue-300
            hover:bg-blue-50/20 transition-all block space-y-2"
        >
          <div
            class="w-8 h-8 rounded bg-amber-100 text-amber-700 flex
              items-center justify-center font-bold text-xs"
          >
            02
          </div>
          <h3 class="text-base font-bold text-slate-900">
            Design Patterns
          </h3>
          <p class="text-[1.1rem] text-slate-600 leading-relaxed">
            Lock-free SAB ring buffers, Atomics synchronization, and compiled
            WASM DSP kernels.
          </p>
        </a>

        <a
          href={guidesUrl}
          class="p-5 rounded-lg border border-slate-200 hover:border-blue-300
            hover:bg-blue-50/20 transition-all block space-y-2"
        >
          <div
            class="w-8 h-8 rounded bg-emerald-100 text-emerald-700 flex
              items-center justify-center font-bold text-xs"
          >
            03
          </div>
          <h3 class="text-base font-bold text-slate-900">
            Migration Guides
          </h3>
          <p class="text-[1.1rem] text-slate-600 leading-relaxed">
            Architectural paths from legacy ScriptProcessorNode to
            low-latency AudioWorklet processors.
          </p>
        </a>
      </div>
    </section>

    <!-- Bottom Actions -->
    <div
      class="pt-6 flex flex-wrap items-center gap-4 border-t border-slate-200"
    >
      <a
        href={guidesUrl}
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-blue-600
          hover:bg-blue-700 text-white text-sm font-semibold shadow-xs
          transition-colors"
      >
        <span>Explore All 14 Guides</span>
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"
          />
        </svg>
      </a>

      <a
        href={demosUrl}
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-100
          hover:bg-slate-200 text-slate-800 text-sm font-semibold border
          border-slate-300 transition-colors"
      >
        <span>Launch Interactive Demos</span>
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"
          />
        </svg>
      </a>

      <a
        href={showcasesUrl}
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-100
          hover:bg-slate-200 text-slate-800 text-sm font-semibold border
          border-slate-300 transition-colors"
      >
        <span>Showcases &amp; Resources</span>
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"
          />
        </svg>
      </a>

      <a
        href={testsUrl}
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-100
          hover:bg-slate-200 text-slate-800 text-sm font-semibold border
          border-slate-300 transition-colors"
      >
        <span>Tests &amp; Benchmarks</span>
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"
          />
        </svg>
      </a>
    </div>
  </article>
</Layout>
