import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const basicUrl = `${base}/audio-worklet/basic/`;
const designPatternUrl = `${base}/audio-worklet/design-pattern/`;
const migrationUrl = `${base}/audio-worklet/migration/`;
const manualTestsUrl = `${base}/tests/manual/`;
const benchmarksUrl = `${base}/tests/benchmark/`;
const demosUrl = `${base}/demos/`;
const resourcesUrl = `${base}/resources/`;

interface NewsItem {
  title: string;
  milestone: string;
  badgeClass: string;
  url: string;
  summary: string;
}

const newsItems: NewsItem[] = [
  {
    title: 'WebAudio: Configurable render quantum',
    milestone: 'Chrome 153',
    badgeClass: 'bg-blue-100 text-blue-800',
    url: 'https://chromestatus.com/feature/5078190552907776',
    summary:
      'Adds renderSizeHint to AudioContext and OfflineAudioContext, ' +
      'allowing customizable render quantum sizes: a specific frame count, ' +
      '"default" (128 frames), or "hardware".',
  },
  {
    title: 'Immersive Audio Model and Formats (IAMF) decoding support',
    milestone: 'Chrome 153',
    badgeClass: 'bg-blue-100 text-blue-800',
    url: 'https://chromestatus.com/feature/5113656292540416',
    summary:
      'Adds support for decoding and playing back IAMF audio in HTML ' +
      'media elements via Media Source Extensions (MSE).',
  },
  {
    title: 'Web Speech API: Unspoken Punctuation',
    milestone: 'Chrome 151',
    badgeClass: 'bg-blue-100 text-blue-800',
    url: 'https://chromestatus.com/feature/4785284026859520',
    summary:
      'Adds the unspokenPunctuation attribute to SpeechRecognition, ' +
      'automatically inserting punctuation marks based on speech pauses.',
  },
  {
    title: 'Playback Statistics API for WebAudio',
    milestone: 'Chrome 146',
    badgeClass: 'bg-blue-100 text-blue-800',
    url: 'https://chromestatus.com/feature/5172818344148992',
    summary:
      'Adds AudioContext.playbackStats to inspect audio playback metrics, ' +
      'including latency and buffer underruns.',
  },
];
---

<Layout
  title="Web Audio Samples - Developer Portal"
  description="Web Audio API guides, tests, and interactive demos."
  currentPath={base ? `${base}/` : '/'}
>
  <article class="max-w-4xl mx-auto space-y-10 py-4">
    <!-- Hero Header -->
    <header class="space-y-3 pb-2">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900">
        Web Audio Samples
      </h1>
      <p class="text-slate-600 text-[1.05rem] leading-relaxed">
        Web Audio API guides, AudioWorklet design patterns, and interactive
        demos from the Chrome team. Includes implementation examples from
        basic audio routing to WebAssembly audio processing.
      </p>
    </header>

    <!-- [Row 0] News and Updates -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold tracking-tight text-slate-900">
        News and Updates
      </h2>

      <div
        class="rounded-xl border border-slate-200 bg-slate-50/60 p-5
          divide-y divide-slate-200/80"
      >
        {
          newsItems.map((item) => (
            <div class="py-3.5 first:pt-0 last:pb-0 space-y-1.5">
              <div class="flex flex-wrap items-center gap-2.5">
                <span
                  class={`inline-flex items-center px-2 py-0.5 rounded text-xs
                    font-semibold ${item.badgeClass}`}
                >
                  {item.milestone}
                </span>
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-semibold text-slate-900 hover:text-blue-600
                    transition-colors inline-flex items-center gap-1 group
                    text-base"
                >
                  <span>{item.title}</span>
                  <svg
                    class="w-3.5 h-3.5 text-slate-400 group-hover:text-blue-600
                      transition-colors"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0
                        002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    />
                  </svg>
                </a>
              </div>
              <p class="text-[1.05rem] text-slate-600 leading-relaxed">
                {item.summary}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- [Row 1] Guides & Tests -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- AudioWorklet Guides -->
      <div class="space-y-4">
        <div class="space-y-2">
          <h2 class="text-xl font-bold text-slate-900">
            AudioWorklet Guides
          </h2>
          <p class="text-[1.05rem] text-slate-600 leading-relaxed">
            AudioWorklet implementation guides, design patterns, and
            migration examples.
          </p>
        </div>

        <div class="space-y-2 pt-2">
          <a
            href={basicUrl}
            class="p-3.5 rounded-lg border border-slate-200
              hover:border-blue-300 hover:bg-blue-50/20 transition-all block
              group"
          >
            <div
              class="text-lg font-semibold text-slate-900
                group-hover:text-blue-600 flex items-center justify-between"
            >
              <span>Basic</span>
              <span
                class="text-slate-400 group-hover:text-blue-600
                  group-hover:translate-x-0.5 transition-transform"
              >
                &rarr;
              </span>
            </div>
            <p class="text-[1.05rem] text-slate-600 mt-1 leading-relaxed">
              Foundational node setup, lifecycle management, audio parameter
              automation, and message passing.
            </p>
          </a>

          <a
            href={designPatternUrl}
            class="p-3.5 rounded-lg border border-slate-200
              hover:border-blue-300 hover:bg-blue-50/20 transition-all
              block group"
          >
            <div
              class="text-lg font-semibold text-slate-900
                group-hover:text-blue-600 flex items-center justify-between"
            >
              <span>Design Pattern</span>
              <span
                class="text-slate-400 group-hover:text-blue-600
                  group-hover:translate-x-0.5 transition-transform"
              >
                &rarr;
              </span>
            </div>
            <p class="text-[1.05rem] text-slate-600 mt-1 leading-relaxed">
              Multi-threaded audio architectures, shared memory
              synchronization, and WebAssembly integration.
            </p>
          </a>

          <a
            href={migrationUrl}
            class="p-3.5 rounded-lg border border-slate-200
              hover:border-blue-300 hover:bg-blue-50/20 transition-all
              block group"
          >
            <div
              class="text-lg font-semibold text-slate-900
                group-hover:text-blue-600 flex items-center justify-between"
            >
              <span>Migration Guide</span>
              <span
                class="text-slate-400 group-hover:text-blue-600
                  group-hover:translate-x-0.5 transition-transform"
              >
                &rarr;
              </span>
            </div>
            <p class="text-[1.05rem] text-slate-600 mt-1 leading-relaxed">
              Migration strategies and patterns for transitioning legacy
              ScriptProcessorNode pipelines to AudioWorklet.
            </p>
          </a>
        </div>
      </div>

      <!-- Tests and Benchmarks -->
      <div class="space-y-4">
        <div class="space-y-2">
          <h2 class="text-xl font-bold text-slate-900">
            Tests and Benchmarks
          </h2>
          <p class="text-[1.05rem] text-slate-600 leading-relaxed">
            Verification test fixtures and performance benchmarks for Web Audio
            features.
          </p>
        </div>

        <div class="space-y-2 pt-2">
          <a
            href={manualTestsUrl}
            class="p-3.5 rounded-lg border border-slate-200
              hover:border-blue-300 hover:bg-blue-50/20 transition-all
              block group"
          >
            <div
              class="text-lg font-semibold text-slate-900
                group-hover:text-blue-600 flex items-center justify-between"
            >
              <span>Manual Tests</span>
              <span
                class="text-slate-400 group-hover:text-blue-600
                  group-hover:translate-x-0.5 transition-transform"
              >
                &rarr;
              </span>
            </div>
            <p class="text-[1.05rem] text-slate-600 mt-1 leading-relaxed">
              Verification test fixtures for audio node behavior, device output
              routing, and browser API compliance.
            </p>
          </a>

          <a
            href={benchmarksUrl}
            class="p-3.5 rounded-lg border border-slate-200
              hover:border-blue-300 hover:bg-blue-50/20 transition-all
              block group"
          >
            <div
              class="text-lg font-semibold text-slate-900
                group-hover:text-blue-600 flex items-center justify-between"
            >
              <span>Benchmarks</span>
              <span
                class="text-slate-400 group-hover:text-blue-600
                  group-hover:translate-x-0.5 transition-transform"
              >
                &rarr;
              </span>
            </div>
            <p class="text-[1.05rem] text-slate-600 mt-1 leading-relaxed">
              Performance measurements and stress tests for audio render
              capacity, buffer latency, and processing load.
            </p>
          </a>
        </div>
      </div>
    </section>

    <!-- [Row 2] Apps & Demos and Resources -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Apps & Demos -->
      <div class="space-y-4">
        <div class="space-y-3">
          <h2 class="text-xl font-bold text-slate-900">
            Apps &amp; Demos
          </h2>
          <p class="text-[1.05rem] text-slate-600 leading-relaxed">
            Interactive applications demonstrating real-time audio synthesis,
            signal processing pipelines, and user interface integration.
          </p>
        </div>

        <div class="pt-2">
          <a
            href={demosUrl}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg
              bg-slate-100 hover:bg-blue-600 text-slate-700 hover:text-white
              text-base font-semibold border border-slate-200
              hover:border-blue-600 active:bg-blue-700 transition-colors group"
          >
            <span>View Apps &amp; Demos</span>
            <span
              class="group-hover:translate-x-0.5 transition-transform"
            >
              &rarr;
            </span>
          </a>
        </div>
      </div>

      <!-- Resources -->
      <div class="space-y-4">
        <div class="space-y-3">
          <h2 class="text-xl font-bold text-slate-900">
            Resources
          </h2>
          <p class="text-[1.05rem] text-slate-600 leading-relaxed">
            Web standards specifications, browser implementation trackers,
            platform roadmaps, and developer documentation.
          </p>
        </div>

        <div class="pt-2">
          <a
            href={resourcesUrl}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg
              bg-slate-100 hover:bg-blue-600 text-slate-700 hover:text-white
              text-base font-semibold border border-slate-200
              hover:border-blue-600 active:bg-blue-700 transition-colors group"
          >
            <span>View Resources</span>
            <span
              class="group-hover:translate-x-0.5 transition-transform"
            >
              &rarr;
            </span>
          </a>
        </div>
      </div>
    </section>
  </article>
</Layout>


