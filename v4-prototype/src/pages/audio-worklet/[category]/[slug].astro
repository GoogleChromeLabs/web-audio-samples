---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: {
      category: guide.data.category,
      slug: guide.id,
    },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const githubSourceUrl =
  'https://github.com/GoogleChromeLabs/web-audio-samples/tree/main/src/' +
  `audio-worklet/${guide.data.category}/${guide.id}`;

const bugReportUrl =
  'https://github.com/GoogleChromeLabs/web-audio-samples/issues/new?' +
  `title=${encodeURIComponent(`[${guide.data.title}] Issue`)}&labels=bug`;
---

<Layout
  title={`${guide.data.title} - Web Audio Samples`}
  description={guide.data.description}
  currentPath={`/audio-worklet/${guide.data.category}/${guide.id}/`}
>
  <article class="max-w-4xl space-y-8">
    <!-- Guide Header -->
    <header class="space-y-2">
      <div class="flex items-center gap-2">
        <span
          class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-blue-50
            text-blue-700 border border-blue-200 uppercase tracking-wider"
        >
          {guide.data.category}
        </span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">
        {guide.data.title}
      </h1>
      {
        guide.data.description && (
          <p class="text-slate-600 text-base leading-relaxed">
            {guide.data.description}
          </p>
        )
      }
    </header>

    <!-- Guide Content -->
    <div
      class="guide-content prose max-w-none text-slate-700 leading-normal"
    >
      <Content />
    </div>

    <!-- Guide Footer -->
    <footer
      class="pt-8 mt-12 border-t border-slate-200 flex flex-wrap items-center
        justify-between gap-4 text-sm"
    >
      <a
        href={githubSourceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 font-medium text-slate-700
          hover:text-blue-600 transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504
              .5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605
              -3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908
              -.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53
              2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253
              -4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103
              -.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564
              0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747
              -1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028
              1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309
              .678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18
              .58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
          ></path>
        </svg>
        <span>View Source on GitHub</span>
      </a>

      <a
        href={bugReportUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border
          border-slate-200 bg-white text-xs font-medium text-slate-700
          hover:text-red-600 hover:border-red-200 hover:bg-red-50/50
          transition-colors shadow-sm"
      >
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3
              L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333
              .192 3 1.732 3z"
          />
        </svg>
          <span>Report an Issue</span>
        </a>
      </div>
    </footer>
  </article>
</Layout>

<script>
  function setupCodeBlockCopyButtons() {
    const copySvg =
      '<svg class="w-3.5 h-3.5 opacity-70" fill="none" viewBox="0 0 24 24" ' +
      'stroke="currentColor">' +
      '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" ' +
      'd="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 ' +
      '002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />' +
      '</svg>';

    const checkSvg =
      '<svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 ' +
      '24 24" stroke="currentColor">' +
      '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" ' +
      'd="M5 13l4 4L19 7" />' +
      '</svg>';

    const preElements = document.querySelectorAll('.guide-content pre');

    preElements.forEach((pre) => {
      if (pre.parentElement?.classList.contains('code-block-wrapper')) {
        return;
      }

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper relative group my-4';

      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      const button = document.createElement('button');
      button.type = 'button';
      button.className =
        'copy-code-btn absolute top-2.5 right-2.5 flex items-center gap-1.5 ' +
        'px-2 py-1 rounded-md text-[11px] font-medium tracking-wide ' +
        'text-slate-300 bg-slate-800/80 hover:bg-slate-700 border ' +
        'border-slate-600/60 shadow-sm transition-all duration-150 ' +
        'cursor-pointer select-none opacity-70 sm:opacity-0 ' +
        'sm:group-hover:opacity-100 focus:opacity-100';
      button.setAttribute('aria-label', 'Copy code to clipboard');
      button.title = 'Copy code';
      button.innerHTML = `${copySvg}<span>Copy</span>`;

      button.addEventListener('click', async () => {
        const codeElement = pre.querySelector('code');
        const codeText =
          codeElement ? codeElement.innerText : (pre as HTMLElement).innerText;

        try {
          await navigator.clipboard.writeText(codeText);
          button.innerHTML =
            `${checkSvg}<span class="text-emerald-300">Copied!</span>`;
          setTimeout(() => {
            button.innerHTML = `${copySvg}<span>Copy</span>`;
          }, 2000);
        } catch (error) {
          console.error('Failed to copy code: ', error);
        }
      });

      wrapper.appendChild(button);
    });
  };

  const setupOverviewTeaser = () => {
    const content = document.getElementById('overview-content');
    const toggleBtn = document.getElementById('overview-toggle-btn');

    if (!content || !toggleBtn) return;

    const btnText = toggleBtn.querySelector('.btn-text');

    toggleBtn.addEventListener('click', () => {
      const isExpanded = content.classList.contains('is-expanded');
      if (isExpanded) {
        content.classList.remove('is-expanded');
        content.classList.add('is-collapsed');
        toggleBtn.classList.remove('is-expanded');
        toggleBtn.setAttribute('aria-expanded', 'false');
        if (btnText) btnText.textContent = 'See more';
        content.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        content.classList.remove('is-collapsed');
        content.classList.add('is-expanded');
        toggleBtn.classList.add('is-expanded');
        toggleBtn.setAttribute('aria-expanded', 'true');
        if (btnText) btnText.textContent = 'See less';
      }
    });
  };

  const initGuidePage = () => {
    setupCodeBlockCopyButtons();
    setupOverviewTeaser();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGuidePage);
  } else {
    initGuidePage();
  }
</script>
