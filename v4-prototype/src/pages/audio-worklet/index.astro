---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allGuides = await getCollection('guides');

const basicGuides = allGuides
  .filter((g) => g.data.category === 'basic')
  .sort((a, b) => a.data.order - b.data.order);

const patternGuides = allGuides
  .filter((g) => g.data.category === 'design-pattern')
  .sort((a, b) => a.data.order - b.data.order);

const migrationGuides = allGuides
  .filter((g) => g.data.category === 'migration')
  .sort((a, b) => a.data.order - b.data.order);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = base ? `${base}/audio-worklet/` : '/audio-worklet/';
---

<Layout
  title="AudioWorklet Guides & Design Patterns - Web Audio Samples"
  description="Comprehensive AudioWorklet design patterns and migration guides."
  currentPath={currentPath}
>
  <article class="max-w-4xl space-y-12">
    <header class="space-y-3 border-b border-slate-200 pb-6">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">
        AudioWorklet Guides &amp; Patterns
      </h1>
      <p class="text-slate-600 text-base leading-relaxed">
        Explore modern AudioWorklet implementation guides, high-performance
        WASM/SharedArrayBuffer patterns, and migration pathways.
      </p>
    </header>

    <!-- Basic Guides Section -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-slate-900">
        Basic AudioWorklet Guides
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          basicGuides.map((guide) => (
            <a
              href={`${base}/audio-worklet/basic/${guide.id}/`}
              class="p-5 rounded-lg border border-slate-200
                hover:border-blue-300 hover:bg-blue-50/30 transition-all
                block space-y-2"
            >
              <h3 class="font-semibold text-slate-900 text-base">
                {guide.data.title}
              </h3>
              {guide.data.description && (
                <p class="text-xs text-slate-600 leading-relaxed">
                  {guide.data.description}
                </p>
              )}
            </a>
          ))
        }
      </div>
    </section>

    <!-- Design Patterns Section -->
    <section class="space-y-4 pt-4 border-t border-slate-200">
      <h2 class="text-xl font-bold text-slate-900">
        Design Patterns &amp; WASM
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          patternGuides.map((guide) => (
            <a
              href={`${base}/audio-worklet/design-pattern/${guide.id}/`}
              class="p-5 rounded-lg border border-slate-200
                hover:border-blue-300 hover:bg-blue-50/30 transition-all
                block space-y-2"
            >
              <h3 class="font-semibold text-slate-900 text-base">
                {guide.data.title}
              </h3>
              {guide.data.description && (
                <p class="text-xs text-slate-600 leading-relaxed">
                  {guide.data.description}
                </p>
              )}
            </a>
          ))
        }
      </div>
    </section>

    <!-- Migration Section -->
    <section class="space-y-4 pt-4 border-t border-slate-200">
      <h2 class="text-xl font-bold text-slate-900">
        Migration Guides
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          migrationGuides.map((guide) => (
            <a
              href={`${base}/audio-worklet/migration/${guide.id}/`}
              class="p-5 rounded-lg border border-slate-200
                hover:border-blue-300 hover:bg-blue-50/30 transition-all
                block space-y-2"
            >
              <h3 class="font-semibold text-slate-900 text-base">
                {guide.data.title}
              </h3>
              {guide.data.description && (
                <p class="text-xs text-slate-600 leading-relaxed">
                  {guide.data.description}
                </p>
              )}
            </a>
          ))
        }
      </div>
    </section>
  </article>
</Layout>
