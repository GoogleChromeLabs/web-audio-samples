import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const allGuides = await getCollection('guides');

const guides = allGuides
  .filter((g) => g.data.category === 'design-pattern')
  .sort((a, b) => a.data.order - b.data.order);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath =
  base
    ? `${base}/audio-worklet/design-pattern/`
    : '/audio-worklet/design-pattern/';

const breadcrumbs = [{ label: 'Audio Worklet Guides' }];
---

<Layout
  title="Design Pattern - Audio Worklet Guides - Web Audio Samples"
  description="High-performance AudioWorklet patterns, WASM, and ring buffers."
  currentPath={currentPath}
>
  <article class="max-w-4xl mx-auto space-y-8">
    <header class="space-y-3 pb-2">
      <Breadcrumb items={breadcrumbs} />
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">
        Design Pattern
      </h1>
      <p class="text-slate-600 text-[1.05rem] leading-relaxed">
        Advanced architectural patterns for high-performance audio synthesis,
        lock-free SharedArrayBuffer ring buffers, and WebAssembly integration.
      </p>
    </header>

    <section class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          guides.map((guide) => (
            <a
              href={`${base}/audio-worklet/design-pattern/${guide.id}/`}
              class="p-5 rounded-lg border border-slate-200
                hover:border-blue-300 hover:bg-blue-50/30 transition-all
                block space-y-2 group"
            >
              <h2
                class="font-semibold text-slate-900 text-xl
                  group-hover:text-blue-600 transition-colors"
              >
                {guide.data.title}
              </h2>
              {guide.data.description && (
                <p class="text-[1.05rem] text-slate-600 leading-relaxed">
                  {guide.data.description}
                </p>
              )}
            </a>
          ))
        }
      </div>
    </section>
  </article>
</Layout>
