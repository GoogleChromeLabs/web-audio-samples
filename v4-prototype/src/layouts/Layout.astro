---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = 'Web Audio Samples',
  description = 'Web Audio API samples, guides, and developer resources.',
  currentPath = '/',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/chrome-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-slate-900 min-h-screen flex flex-col antialiased">
    <Header />
    <Sidebar currentPath={currentPath} />

    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 py-8">
      <slot />
    </main>
  </body>
</html>
