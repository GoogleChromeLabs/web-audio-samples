import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import InteractiveDemoBox from '../components/InteractiveDemoBox.astro';

interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath =
  `${base}/audio-worklet/${guide.data.category}/${guide.id}/`;

const githubSourceUrl =
  'https://github.com/GoogleChromeLabs/web-audio-samples/tree/main/src/' +
  `audio-worklet/${guide.data.category}/${guide.id}`;

const bugReportUrl =
  'https://github.com/GoogleChromeLabs/web-audio-samples/issues/new?' +
  `title=${encodeURIComponent(`[${guide.data.title}] Issue`)}&labels=bug`;

const demoScript =
  guide.data.demoScript ??
  `${base}/audio-worklet/${guide.data.category}/${guide.id}/main.js`;
---

<Layout
  title={`${guide.data.title} - Web Audio Samples`}
  description={guide.data.description}
  currentPath={currentPath}
  githubUrl={githubSourceUrl}
  bugReportUrl={bugReportUrl}
>
  <article class="max-w-4xl space-y-8">
    <!-- 1. [Title] & [1-line description] -->
    <header class="space-y-2">
      <div class="flex items-center gap-2">
        <span
          class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-blue-50
            text-blue-700 border border-blue-200 uppercase tracking-wider"
        >
          {guide.data.category.replace(/-/g, ' ')}
        </span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">
        {guide.data.title}
      </h1>
      {
        guide.data.description && (
          <p class="text-slate-600 text-base leading-relaxed">
            {guide.data.description}
          </p>
        )
      }
    </header>

    <!-- 2. [Interactive demo box (including AudioControlPanel)] -->
    {
      guide.data.hasDemo && (
        <InteractiveDemoBox
          title={guide.data.demoTitle ?? 'Audio Playback Check'}
          description={
            guide.data.demoDescription ??
            'Click START to run the bypass worklet node.'
          }
          scriptSrc={demoScript}
        >
          <slot name="demo-controls" />
        </InteractiveDemoBox>
      )
    }

    <!-- 3. Guide Documentation -->
    <section class="space-y-4 pt-2">
      <div
        id="guide-content"
        class="guide-content prose max-w-none text-slate-700 leading-normal"
      >
        <slot />
      </div>
    </section>

  </article>
</Layout>

<script>
  function setupCodeBlockCopyButtons() {
    const copySvg =
      '<svg class="w-3.5 h-3.5 opacity-70" fill="none" viewBox="0 0 24 24" ' +
      'stroke="currentColor">' +
      '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" ' +
      'd="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 ' +
      '002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />' +
      '</svg>';

    const checkSvg =
      '<svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 ' +
      '24 24" stroke="currentColor">' +
      '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" ' +
      'd="M5 13l4 4L19 7" />' +
      '</svg>';

    const preElements = document.querySelectorAll('.guide-content pre');

    preElements.forEach((pre) => {
      if (pre.parentElement?.classList.contains('code-block-wrapper')) {
        return;
      }

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper relative group my-4';

      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      const button = document.createElement('button');
      button.type = 'button';
      button.className =
        'copy-code-btn absolute top-2.5 right-2.5 flex items-center gap-1.5 ' +
        'px-2 py-1 rounded-md text-[11px] font-medium tracking-wide ' +
        'text-slate-300 bg-slate-800/80 hover:bg-slate-700 border ' +
        'border-slate-600/60 shadow-sm transition-all duration-150 ' +
        'cursor-pointer select-none opacity-70 sm:opacity-0 ' +
        'sm:group-hover:opacity-100 focus:opacity-100';
      button.setAttribute('aria-label', 'Copy code to clipboard');
      button.title = 'Copy code';
      button.innerHTML = `${copySvg}<span>Copy</span>`;

      button.addEventListener('click', async () => {
        const codeElement = pre.querySelector('code');
        const codeText =
          codeElement ? codeElement.innerText : (pre as HTMLElement).innerText;

        try {
          await navigator.clipboard.writeText(codeText);
          button.innerHTML =
            `${checkSvg}<span class="text-emerald-300">Copied!</span>`;
          setTimeout(() => {
            button.innerHTML = `${copySvg}<span>Copy</span>`;
          }, 2000);
        } catch (error) {
          console.error('Failed to copy code: ', error);
        }
      });

      wrapper.appendChild(button);
    });
  }

  const setupTechnicalDetailsTeaser = () => {
    const content = document.getElementById('guide-content');
    if (!content) return;

    const headings = Array.from(content.querySelectorAll('h2'));
    const techHeading = headings.find(
      (h) =>
        h.id === 'technical-details' ||
        h.textContent?.trim().toLowerCase() === 'technical details'
    );

    if (!techHeading) return;

    const techNodes = [];
    let curr = techHeading;
    while (curr) {
      const next = curr.nextSibling;
      techNodes.push(curr);
      curr = next;
    }

    const teaserWrapper = document.createElement('div');
    teaserWrapper.className = 'tech-teaser-wrapper relative mt-8';

    const teaserContent = document.createElement('div');
    teaserContent.id = 'tech-teaser-content';
    teaserContent.className = 'tech-teaser-content is-collapsed';

    techNodes.forEach((node) => teaserContent.appendChild(node));
    teaserWrapper.appendChild(teaserContent);

    const fadeOverlay = document.createElement('div');
    fadeOverlay.className = 'tech-fade-overlay';

    const toggleBtn = document.createElement('button');
    toggleBtn.id = 'tech-toggle-btn';
    toggleBtn.type = 'button';
    toggleBtn.className = 'overview-chip-btn';
    toggleBtn.setAttribute('aria-expanded', 'false');

    const chevronSvg =
      '<svg class="btn-icon w-3.5 h-3.5" viewBox="0 0 20 20" ' +
      'fill="currentColor">' +
      '<path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 ' +
      '11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 ' +
      '01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"></path>' +
      '</svg>';

    toggleBtn.innerHTML =
      `<span class="btn-text">See more</span>${chevronSvg}`;
    fadeOverlay.appendChild(toggleBtn);
    teaserWrapper.appendChild(fadeOverlay);

    content.appendChild(teaserWrapper);

    const btnText = toggleBtn.querySelector('.btn-text');

    toggleBtn.addEventListener('click', () => {
      const isExpanded = teaserContent.classList.contains('is-expanded');
      if (isExpanded) {
        teaserContent.classList.remove('is-expanded');
        teaserContent.classList.add('is-collapsed');
        toggleBtn.classList.remove('is-expanded');
        toggleBtn.setAttribute('aria-expanded', 'false');
        if (btnText) btnText.textContent = 'See more';
        teaserWrapper.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        teaserContent.classList.remove('is-collapsed');
        teaserContent.classList.add('is-expanded');
        toggleBtn.classList.add('is-expanded');
        toggleBtn.setAttribute('aria-expanded', 'true');
        if (btnText) btnText.textContent = 'See less';
      }
    });
  };

  const setupTableWrappers = () => {
    const tables = document.querySelectorAll('.guide-content table');
    tables.forEach((table) => {
      if (table.parentElement?.classList.contains('table-wrapper')) {
        return;
      }
      const wrapper = document.createElement('div');
      wrapper.className = 'table-wrapper';
      table.parentNode?.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    });
  };

  const initGuidePage = () => {
    setupCodeBlockCopyButtons();
    setupTableWrappers();
    setupTechnicalDetailsTeaser();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGuidePage);
  } else {
    initGuidePage();
  }
</script>
